def read_numbers():
    """
    Считывает список чисел с клавиатуры.
    При некорректном вводе запрашивает данные повторно.
    """
    while True:
        user_input = input("Введите числа через пробел: ")

        if user_input.strip() == "":
            print("Ошибка: список чисел не должен быть пустым.")
            continue

        numbers_as_strings = user_input.split()
        numbers = []

        correct_input = True

        for item in numbers_as_strings:
            try:
                number = float(item)
                numbers.append(number)
            except ValueError:
                print("Ошибка: все элементы списка должны быть числами.")
                correct_input = False
                break

        if correct_input:
            return numbers


def count_numbers(numbers):
    """
    Подсчитывает количество положительных,
    отрицательных и равных нулю чисел.
    """
    positive_count = 0
    negative_count = 0
    zero_count = 0

    for number in numbers:
        if number > 0:
            positive_count += 1
        elif number < 0:
            negative_count += 1
        else:
            zero_count += 1

    return positive_count, negative_count, zero_count


def main():
    """
    Основная функция программы.
    """
    print("Программа подсчитывает количество положительных,")
    print("отрицательных и равных нулю чисел в списке.")

    numbers = read_numbers()

    positive_count, negative_count, zero_count = count_numbers(numbers)

    print("\nРезультат:")
    print("Введенный список чисел:", numbers)
    print("Количество положительных чисел:", positive_count)
    print("Количество отрицательных чисел:", negative_count)
    print("Количество чисел, равных нулю:", zero_count)


main()
